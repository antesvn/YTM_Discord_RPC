{
  "manifest_version": 3,
  "name": "YTM Discord RPC",
  "version": "0.3.0",
  "description": "Detecta informações da música atual no YouTube Music e envia para um programa local.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:38473/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
